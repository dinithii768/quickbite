# ╔══════════════════════════════════════════════════════╗
# ║           QUICKBITE ENVIRONMENT VARIABLES           ║
# ║                                                      ║
# ║  Copy this file to .env and fill in real values.    ║
# ║  NEVER commit .env to GitHub.                       ║
# ╚══════════════════════════════════════════════════════╝

# ─────────────────────────────────────────
# RESTAURANT SERVICE DATABASE
# ─────────────────────────────────────────
RESTAURANT_DB_HOST=localhost
RESTAURANT_DB_PORT=5432
RESTAURANT_DB_NAME=quickbite_restaurant_db
RESTAURANT_DB_USERNAME=your_db_username
RESTAURANT_DB_PASSWORD=your_db_password

# ─────────────────────────────────────────
# ORDER SERVICE DATABASE
# ─────────────────────────────────────────
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5433
ORDER_DB_NAME=quickbite_order_db
ORDER_DB_USERNAME=your_db_username
ORDER_DB_PASSWORD=your_db_password

# ─────────────────────────────────────────
# API KEYS (for microservice security)
# ─────────────────────────────────────────
RESTAURANT_SERVICE_API_KEY=your_restaurant_api_key_here
ORDER_SERVICE_API_KEY=your_order_api_key_here

# ─────────────────────────────────────────
# KEYCLOAK (OAuth 2.0 Authentication)
# ─────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=quickbite-realm
KEYCLOAK_CLIENT_ID=quickbite-gateway
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

# ─────────────────────────────────────────
# REDIS (Rate Limiting)
# ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────
# API GATEWAY
# ─────────────────────────────────────────
GATEWAY_PORT=8080
RESTAURANT_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082

# ─────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=quickbite-realm
VITE_KEYCLOAK_CLIENT_ID=quickbite-frontend